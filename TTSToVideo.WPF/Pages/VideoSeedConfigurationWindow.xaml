<Window x:Class="TTSToVideo.WPF.Pages.VideoSeedConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Video Configuration"
        Height="240"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontWeight="Bold" Text="Video Generation Configuration"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,8,0" VerticalAlignment="Center" Text="Seed"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                 Text="{Binding Model.VideoSeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,8,0" VerticalAlignment="Center" Text="Width"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                 Text="{Binding Model.VideoWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,8,0" VerticalAlignment="Center" Text="Height"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"
                 Text="{Binding Model.VideoHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0" Text="Leave empty to use default size."/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="80" Margin="0,0,8,0" Click="Save_Click">Save</Button>
            <Button Width="80" Click="Cancel_Click">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
